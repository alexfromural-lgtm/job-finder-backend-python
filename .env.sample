PORT=5002
APP_ENV=development

# Database Configuration
DB_HOST=job-finder-db-python
DB_NAME=job-finder
DB_USER=job_finder_user
DB_PASS=secure_password_123
DATABASE_URL=postgresql+asyncpg://job_finder_user:secure_password_123@job-finder-db-python:5432/job_finder

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# JWT Token Secrets (generate strong random values for production)
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
ACCESS_TOKEN_MAX_AGE_MS=900000

REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_MAX_AGE_MS=604800000

# Redis / Message Queue
REDIS_URL=redis://job-finder-redis-python:6379
QUEUE_CONCURRENCY=5

# CORS
CORS_ORIGIN=http://localhost:3000
